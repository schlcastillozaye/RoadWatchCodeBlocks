# RoadWatch — root ignores

# dependencies & build output
node_modules/
dist/
build/

# environment files (ship .env.example instead)
.env
.env.local
.env.*.local
# production env files must never be committed
.env.production
.env.*.production

# logs
*.log
npm-debug.log*

# mobile (Flutter)
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/key.properties
# keep real Google service files out of VCS; ship .example versions
mobile/android/app/google-services.json
mobile/ios/Runner/GoogleService-Info.plist

# web (Vite)
web/node_modules/
web/dist/

# backend runtime data (uploaded images live here, never in the database)
backend/uploads/

# python scratch tools
_tools/__pycache__/
