// ===========================================================================
//  RoadWatch — Prisma schema (MySQL)
//  Run:  npm run prisma:generate   then   npm run db:push
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
//  Enums
// ----------------------------------------------------------------------------

enum Role {
  CITIZEN
  MAINTENANCE_OFFICER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Category {
  POTHOLE
  DAMAGED_PAVEMENT
  ROAD_CRACK
  FLOODING
  DAMAGED_DRAINAGE
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Moderation is deliberately separated from repair to avoid confusion.
enum ModerationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum RepairStatus {
  NOT_ASSIGNED
  AWAITING_MAINTENANCE
  IN_PROGRESS
  COMPLETED
}

enum PhotoKind {
  BEFORE
  PROGRESS
  AFTER
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HistoryType {
  CREATION
  MODERATION
  ASSIGNMENT
  REPAIR
}

enum AnalysisStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

// ----------------------------------------------------------------------------
//  Users & auth
// ----------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  phone        String?
  passwordHash String
  role         Role       @default(CITIZEN)
  status       UserStatus @default(ACTIVE)
  avatarKey    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  reports           Report[]        @relation("ReportCitizen")
  moderatedReports  Report[]        @relation("ReportModerator")
  assignedReports   Report[]        @relation("ReportOfficer")
  photos            ReportPhoto[]
  assignmentsAsOfficer Assignment[] @relation("AssignmentOfficer")
  assignmentsCreated   Assignment[] @relation("AssignmentAssigner")
  statusChanges     StatusHistory[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]
  analysisResults   ImageAnalysisResult[]
  notifications     Notification[]

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ----------------------------------------------------------------------------
//  Reports
// ----------------------------------------------------------------------------

model Report {
  id          String   @id @default(cuid())
  /// Human-readable unique reference, e.g. RW-2026-000123
  referenceNo String   @unique
  title       String
  description String   @db.Text
  category    Category
  priority    Priority @default(MEDIUM)

  // Location
  latitude    Float
  longitude   Float
  /// Reverse-geocoded / manually entered address (nullable when unavailable)
  addressText String?
  /// Coarse area label for grouping/filtering (barangay / district / city)
  areaLabel   String?

  // Moderation (separate from repair)
  moderationStatus ModerationStatus @default(PENDING_REVIEW)
  rejectionReason  String?          @db.Text
  moderatedById    String?
  moderatedAt      DateTime?

  // Repair
  repairStatus     RepairStatus @default(NOT_ASSIGNED)
  assignedOfficerId String?
  assignedAt        DateTime?
  completedAt       DateTime?
  completionNotes   String?     @db.Text
  completionOverride Boolean    @default(false)

  // Relations
  citizenId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  citizen    User    @relation("ReportCitizen", fields: [citizenId], references: [id])
  moderatedBy User?  @relation("ReportModerator", fields: [moderatedById], references: [id])
  assignedOfficer User? @relation("ReportOfficer", fields: [assignedOfficerId], references: [id])

  photos       ReportPhoto[]
  assignments  Assignment[]
  notifications Notification[]
  history      StatusHistory[]
  analysis     ImageAnalysisResult[]

  @@index([moderationStatus])
  @@index([repairStatus])
  @@index([category])
  @@index([citizenId])
  @@index([assignedOfficerId])
  @@index([latitude, longitude])
  @@index([createdAt])
}

model ReportPhoto {
  id         String    @id @default(cuid())
  reportId   String
  kind       PhotoKind @default(BEFORE)
  storageKey String
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  /// base64 blur placeholder for fast mobile loading (small)
  blurData   String?   @db.Text
  caption    String?
  uploadedById String?
  createdAt  DateTime  @default(now())

  report     Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id])
  analysis   ImageAnalysisResult[]

  @@index([reportId])
  @@index([kind])
}

model Assignment {
  id           String           @id @default(cuid())
  reportId     String
  officerId    String
  assignedById String
  status       AssignmentStatus @default(ASSIGNED)
  note         String?          @db.Text
  dueDate      DateTime?
  createdAt    DateTime         @default(now())
  completedAt  DateTime?

  report     Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  officer    User   @relation("AssignmentOfficer", fields: [officerId], references: [id])
  assignedBy User   @relation("AssignmentAssigner", fields: [assignedById], references: [id])
  notifications Notification[]

  @@index([reportId])
  @@index([officerId])
  @@index([status])
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  assignmentId String   @unique
  reportId     String
  title        String
  message      String   @db.Text
  category     String
  location     String   @db.VarChar(500)
  repairStatus String
  readAt       DateTime?
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  report     Report     @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([reportId])
}

/// Immutable trail of moderation / repair / assignment changes.
model StatusHistory {
  id         String      @id @default(cuid())
  reportId   String
  type       HistoryType
  fromValue  String?
  toValue    String
  note       String?     @db.Text
  actorId    String?
  actorRole  Role?
  createdAt  DateTime    @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([reportId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  Role?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
//  Optional image processing (future-ready, stored separately)
// ----------------------------------------------------------------------------

model ImageAnalysisResult {
  id         String         @id @default(cuid())
  reportId   String
  photoId    String?
  provider   String
  status     AnalysisStatus @default(PENDING)
  /// Detected issues, severity estimates, quality checks, duplicate hashes, etc.
  result     Json?
  confidence Float?
  error      String?        @db.Text
  createdById String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  report Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  photo  ReportPhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@index([reportId])
  @@index([photoId])
  @@index([status])
}

// ----------------------------------------------------------------------------
//  Reference-number sequence (transaction-safe generation)
// ----------------------------------------------------------------------------

model ReferenceCounter {
  year  Int    @id
  value Int    @default(0)
}
