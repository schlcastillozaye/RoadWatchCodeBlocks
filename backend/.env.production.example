# ---------------------------------------------------------------------------
# RoadWatch backend — production / hosting environment template.
# Copy these values into your host's dashboard (e.g. Railway) — do NOT commit
# real secrets. See docs/deployment-checklist.md for the full walkthrough.
# ---------------------------------------------------------------------------

NODE_ENV=production
# Most hosts (Railway, Fly, Render) inject PORT automatically; keep 4000 as
# the default for Docker/VPS.
PORT=4000

# Comma-separated origins allowed to call the API (your web platform URL).
# No trailing slash. Example:
#   https://roadwatch-web.up.railway.app,https://roadwatch.yourdomain.com
CORS_ORIGINS=

# Managed MySQL 8 connection string. URL-encode special characters in the
# password (e.g. ! -> %21, @ -> %40).
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED
DATABASE_URL=

# Authentication secrets — generate long random values, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Public URL of THIS API (used to build absolute image URLs).
#   https://roadwatch-api.up.railway.app
PUBLIC_BASE_URL=

# Image storage is kept in the existing MySQL database. This avoids ephemeral
# container filesystems and does not require a separately billed storage service.
STORAGE_DRIVER=database
STORAGE_LOCAL_DIR=/app/uploads
MAX_UPLOAD_BYTES=8388608

# S3-compatible object storage — not required by the PHP backend.
# These belonged to the legacy Node stack; setting them has no effect.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Custom endpoint for non-AWS providers (R2, MinIO...). Omit for AWS S3.
S3_ENDPOINT=
# Public base URL for stored objects, if the bucket is public / CDN-backed.
S3_PUBLIC_BASE_URL=

# Optional image-processing module (disabled by default; the app works without it).
IMAGE_PROCESSING_ENABLED=false
IMAGE_PROCESSING_PROVIDER=none
IMAGE_PROCESSING_API_URL=
IMAGE_PROCESSING_API_KEY=

# Geocoding (address search + reverse geocoding) is free by default via
# OpenStreetMap Nominatim — no key needed. Set this only to prefer Google
# Geocoding instead (requires a billing-enabled key).
GOOGLE_MAPS_SERVER_API_KEY=

# Schema bootstrap. The PHP service has no auto-migration entrypoint — run
# `php /app/database/migrate.php` as a Railway pre-deploy command instead.
# SEED_ON_START only affects `migrate.php --seed`; never seed a real database.
# (RUN_MIGRATIONS / RESET_DATABASE belonged to the legacy Node image.)
SEED_ON_START=false
