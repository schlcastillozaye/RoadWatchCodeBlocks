# ---------------------------------------------------------------------------
# RoadWatch backend — production / hosting environment template.
# Copy these values into your host's dashboard (e.g. Render) — do NOT commit
# real secrets. See docs/DEPLOY_RENDER.md for the full walkthrough.
# ---------------------------------------------------------------------------

NODE_ENV=production
# Most hosts (Render, Railway, Fly) inject PORT automatically; keep 4000 as
# the default for Docker/VPS.
PORT=4000

# Comma-separated origins allowed to call the API (your web platform URL).
# No trailing slash. Example:
#   https://roadwatch-web.onrender.com,https://roadwatch.yourdomain.com
CORS_ORIGINS=

# Managed MySQL 8 connection string. URL-encode special characters in the
# password (e.g. ! -> %21, @ -> %40).
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED
DATABASE_URL=

# Authentication secrets — generate long random values, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Public URL of THIS API (used to build absolute image URLs).
#   https://roadwatch-api.onrender.com
PUBLIC_BASE_URL=

# Image storage. Keep "local" for a persistent volume, or use "s3" for
# durable object storage (recommended on ephemeral hosts). See docs/DEPLOYMENT.md.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/uploads
MAX_UPLOAD_BYTES=8388608

# S3-compatible object storage (only when STORAGE_DRIVER=s3).
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, Wasabi, etc.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Custom endpoint for non-AWS providers (R2, MinIO...). Omit for AWS S3.
S3_ENDPOINT=
# Public base URL for stored objects, if the bucket is public / CDN-backed.
S3_PUBLIC_BASE_URL=

# Optional image-processing module (disabled by default; the app works without it).
IMAGE_PROCESSING_ENABLED=false
IMAGE_PROCESSING_PROVIDER=none
IMAGE_PROCESSING_API_URL=
IMAGE_PROCESSING_API_KEY=

# Geocoding (address search + reverse geocoding) is free by default via
# OpenStreetMap Nominatim — no key needed. Set this only to prefer Google
# Geocoding instead (requires a billing-enabled key).
GOOGLE_MAPS_SERVER_API_KEY=

# Entry-point behaviour (see backend/docker-entrypoint.sh).
RUN_MIGRATIONS=true
SEED_ON_START=false
RESET_DATABASE=false
