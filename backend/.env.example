# ---------------------------------------------------------------------------
# RoadWatch backend environment.  Copy to `.env` and adjust.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=4000
# Comma-separated allowed origins for CORS (web platform + tools).
# 8080 = static dev server, 3000 = Flutter web, 5173 = legacy Vite.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost,http://localhost:5173

# Database (MySQL 8.0, created by db/setup.sql)
# NOTE: URL-encode special characters in the password (e.g. ! -> %21).
DATABASE_URL="mysql://roadwatch:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/roadwatch"

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Storage: "local" (default) or "s3" (future)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
# Leave empty for local development. Production local storage requires this to
# equal the mount path of an actual writable persistent volume.
STORAGE_PERSISTENT_MOUNT_PATH=
# Public base URL used to build absolute image URLs. Optional: leave it empty
# and clients will resolve image paths relative to the API base URL they use.
# Set it to the externally reachable API URL in production.
PUBLIC_BASE_URL=http://localhost:4000
# Max upload size per file, bytes (default 8 MB)
MAX_UPLOAD_BYTES=8388608

# --- Optional S3 / object storage (only when STORAGE_DRIVER=s3) -------------
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Optional image-processing module (future AI features) ------------------
# When disabled (default) the system behaves exactly as a plain upload system.
IMAGE_PROCESSING_ENABLED=false
IMAGE_PROCESSING_PROVIDER=none
IMAGE_PROCESSING_API_URL=
IMAGE_PROCESSING_API_KEY=

# --- Geocoding (optional) ---------------------------------------------------
# Address search / reverse geocoding is free by default via OpenStreetMap
# Nominatim — no key needed. Set a Google key only to prefer Google Geocoding
# (requires billing enabled on that key).
GOOGLE_MAPS_SERVER_API_KEY=
