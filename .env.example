# RoadWatch Environment Configuration Example
# Copy this file to .env and fill in the values.
# Never commit real secrets to git.

# ============================================================
# APPLICATION ENVIRONMENT
# ============================================================

# Node/PHP environment
NODE_ENV=production
PORT=4000

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# TiDB Cloud MySQL connection string
# Format: mysql://user:password@host:port/database?sslaccept=strict
# Example: mysql://root:your_password@us-east-1.aws.tidbcloud.com:4000/roadwatch?sslaccept=strict
DATABASE_URL=mysql://YOUR_TIDB_USERNAME:YOUR_TIDB_PASSWORD@YOUR_HOST:4000/roadwatch?sslaccept=strict

# ============================================================
# AUTHENTICATION
# ============================================================

# JWT access token secret (32+ characters minimum)
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long

# JWT refresh token secret (32+ characters minimum)
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long

# JWT Access Token TTL (minutes)
JWT_ACCESS_TTL=15m

# JWT Refresh Token TTL (days)
JWT_REFRESH_TTL=30d

# ============================================================
# CORS CONFIGURATION
# ============================================================

# Comma-separated list of allowed origins
# Example: http://localhost:5173,https://your-domain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ============================================================
# IMAGE STORAGE
# ============================================================

# Storage driver: "local" or "s3"
STORAGE_DRIVER=local

# Local upload directory (relative to app root)
STORAGE_LOCAL_DIR=uploads

# Maximum upload size in bytes (default: 8MB = 8388608)
MAX_UPLOAD_BYTES=8388608

# S3-compatible storage (when STORAGE_DRIVER=s3)
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_ENDPOINT=https://api.r2.cloudflare.com (for Cloudflare R2)

# ============================================================
# MAP CONFIGURATION
# ============================================================

# Google Maps Server API Key (optional, for geocoding)
# Required only if you want to use Google Geocoding instead of OSM Nominatim
GOOGLE_MAPS_SERVER_API_KEY=

# ============================================================
# DEPLOYMENT
# ============================================================

# Seed demo accounts on first boot (true/false)
# Set to false for production; true for initial setup/demo
SEED_ON_START=false

# ============================================================
# WEB PLATFORM
# ============================================================

# API base URL for the web platform (read by app.js at runtime)
# This should match the publicly reachable API URL
VITE_API_BASE_URL=https://roadwatch-api.onrender.com

# ============================================================
# FLUTTER MOBILE APP
# ============================================================

# API base URL for the Flutter mobile app
# Override at build time: flutter run --dart-define=API_BASE_URL=http://10.0.2.2:4000
# The mobile API client reads this from environment variables.
API_BASE_URL=http://10.0.2.2:4000