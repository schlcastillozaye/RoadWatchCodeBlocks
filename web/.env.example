# RoadWatch web platform configuration.
# Copy to `.env` (or `.env.local`) and adjust.

# Base URL of the shared RoadWatch backend API.
VITE_API_BASE_URL=http://localhost:4000

# Google Maps JavaScript API key for the admin/public map view.
# Leave empty to use the built-in list fallback (the platform stays fully usable).
VITE_GOOGLE_MAPS_API_KEY=
